# Copy to `.env` and fill in what you need. `.env` is ignored by git; never commit real keys.
# Every setting is FIXLOOP_<SECTION>__<NAME>; see docs/configuration.md for the full list.

# --- the one thing you must set: a Gemini API key (https://aistudio.google.com/apikey) -------------------
FIXLOOP_GEMINI__API_KEY=
# Or use Vertex AI instead of the Developer API:
# FIXLOOP_GEMINI__VERTEXAI=true
# FIXLOOP_GEMINI__PROJECT=my-gcp-project
# FIXLOOP_GEMINI__LOCATION=us-central1
# Offline / demo mode with a scripted model (no key, no cost):
# FIXLOOP_GEMINI__BACKEND=scripted
# FIXLOOP_GEMINI__SCRIPTED_PATH=examples/demo-script.yaml

# --- environment ---------------------------------------------------------------------------------------
FIXLOOP_ENV=local
# FIXLOOP_API__UPLOAD_TOKEN_SECRET=change-me-in-any-shared-environment

# --- running services on the host instead of in Docker (compose sets these for its containers) -------------
# FIXLOOP_DATABASE__URL=postgresql+asyncpg://fixloop:fixloop@localhost:5432/fixloop
# FIXLOOP_REDIS__QUEUE_URL=redis://localhost:6379/0
# FIXLOOP_REDIS__CACHE_URL=redis://localhost:6380/0
# FIXLOOP_STORAGE__BACKEND=local
# FIXLOOP_STORAGE__LOCAL_ROOT=.fixloop-data/objects

# --- sandbox runner ------------------------------------------------------------------------------------
# docker (default, isolated) or local (NO isolation: only for tests and your own code; needs both flags)
# FIXLOOP_RUNNER__BACKEND=local
# FIXLOOP_RUNNER__ALLOW_UNSAFE_LOCAL=true
# FIXLOOP_RUNNER__INDEX_URL=https://pypi.org/simple
# Production runner hosts use gVisor:
# FIXLOOP_RUNNER__ISOLATION=production
# FIXLOOP_RUNNER__RUNTIME=runsc
# FIXLOOP_RUNNER__REQUIRE_PINNED_IMAGES=true

# --- GitHub App (optional; start the publisher with `docker compose --profile github up -d`) -------------
# FIXLOOP_GITHUB__ENABLED=true
# FIXLOOP_GITHUB__APP_ID=123456
# FIXLOOP_GITHUB__PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# FIXLOOP_GITHUB__WEBHOOK_SECRET=

# --- the fixloop CLI ---------------------------------------------------------------------------------
# FIXLOOP_API_URL=http://localhost:8080
# FIXLOOP_API_KEY=fl_live_...
